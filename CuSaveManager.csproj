<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>CasualtiesUnknown.SaveManager</RootNamespace>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- 程序集信息 -->
		<AssemblyName>CuSaveManager</AssemblyName>
		<Version>1.2.0</Version>
		<Description>Casualties Unknown — 多存档槽位管理与定时备份 mod</Description>

		<!-- 插件信息 -->
		<BepInExPluginGuid>com.casualtiesUnknown.saveManager</BepInExPluginGuid>
		<BepInExPluginName>$(AssemblyName)</BepInExPluginName>
		<BepInExPluginVersion>$(Version)</BepInExPluginVersion>

		<!-- 构建设置 -->
		<DebugType>portable</DebugType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<RestoreAdditionalProjectSources>
			https://nuget.bepinex.dev/v3/index.json
		</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<ItemGroup>
		<!-- 依赖项 -->
		<Reference Include="references\*.dll" Private="false" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
	</ItemGroup>

</Project>
